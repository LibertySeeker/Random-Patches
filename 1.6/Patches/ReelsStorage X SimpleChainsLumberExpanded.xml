<?xml version="1.0" encoding="utf-8" ?>

<Patch>

	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Reel's Expanded Storage</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
			
				<li Class="PatchOperationReplace">
					<xpath>/Defs/ThingDef[defName="ReelStorageWoodPile"]/label</xpath>
					<value>small pile</value>
				</li>
				
				<li Class="PatchOperationReplace">
					<xpath>/Defs/ThingDef[defName="ReelStorageLargeWoodPile"]/label</xpath>
					<value>small pile</value>
				</li>
				
				<li Class="PatchOperationAdd" MayRequire="tm3.SimpleChains.Lumber">
					<xpath>/Defs/ThingDef[defName="ReelStorageWoodPile" or defName="ReelStorageLargeWoodPile"]/stuffCategories</xpath>
					<value>
					  <li>Owl_Firewood</li>
					  <li>Owl_GreenLumber</li>
					  <li>RawWoody</li>
					</value>
				</li>
				
				<li Class="PatchOperationReplace">
					<xpath>Defs/ThingsDef[defName="ReelStorageWoodPile" or defName="ReelStorageLargeWoodPile"]/modExtensions/li[@Class"AdaptiveStorage.Extension"]/lockStorageSettingsToStuff</xpath>
					<value>false</value>
				</li>
				
				<li Class="PatchOperationAdd" MayRequire="tm3.SimpleChains.Lumber">
					<xpath>/Defs/ThingDef[defName="ReelStorageWoodPile" or defName="ReelStorageLargeWoodPile"]/building/fixedStorageSettings/filter/thingDefs/li</xpath>
					<value>
						<fixedStorageSettings>
							<filter>
								<thingDefs>
									<li>Owl_WoodLog</li>					
									<li>Owl_Firewood</li>
									<li>Owl_GreenLumber</li>
									<li>WoodLog</li>
								</thingDefs>
							</filter>
						</fixedStorageSettings>
					</value>
				</li>
				
			</operations>
		</match>
	</Operation>

</Patch>