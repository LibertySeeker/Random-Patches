<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- patches the recipe of making industrial ammo to use materials from Expanded Materials: Metals mod-->

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>[LTS]Ammunition - Simple Ammo Pack</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace" MayRequire="Argon.ExpandedMaterials.Metals">
            <xpath>Defs/RecipeDef[defName="Make_AmmoIndustrial"]/ingredients</xpath>
               <value>
			      <ingredients>
				  
					<li>
					  <filter>
						<thingDefs>
						  <li>Steel</li>
                          <li>EM_MildSteel</li>
						</thingDefs>
					  </filter>
					  <count>5</count>
					</li>
					
					<li>
					  <filter>
						<thingDefs>
						  <li>EM_Lead</li>
						</thingDefs>
					  </filter>
					  <count>5</count>
					</li>
					
					<li>
					  <filter>
						<thingDefs>
						  <li>EM_Copper</li>
						</thingDefs>
					  </filter>
					  <count>2</count>
					</li>
				  </ingredients>
               </value>
        </li>
        <li Class="PatchOperationReplace" MayRequire="Argon.ExpandedMaterials.Metals">
            <xpath>Defs/RecipeDef[defName="Make_AmmoIndustrial"]/fixedIngredientFilter</xpath>
               <value>
				  <fixedIngredientFilter>
					<thingDefs>
					  <li>Steel</li>
                      <li>EM_MildSteel</li>
					</thingDefs>
				  </fixedIngredientFilter>
               </value>
        </li>
      </operations>
    </match>
  </Operation>


  <!-- patches the recipe of making spacer ammo to use materials from Expanded Materials: Metals mod-->

